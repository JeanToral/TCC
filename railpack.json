{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "node": "22",
    "pnpm": "10"
  },
  "caches": {
    "pnpm-store": {
      "directory": "/root/.local/share/pnpm/store",
      "type": "shared"
    }
  },
  "steps": {
    "install": {
      "commands": [
        "pnpm install"
      ]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": [
        "cd backend && pnpm prisma generate --schema ../prisma/schema.prisma",
        "pnpm --filter frontend build",
        "pnpm --filter backend build"
      ]
    }
  },
  "deploy": {
    "startCommand": "cd backend && npx prisma migrate deploy --schema ../prisma/schema.prisma && node dist/main"
  }
}
